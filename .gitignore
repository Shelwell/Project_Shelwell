# ============================================================
# Shelwell .gitignore
# 规则：虚拟环境 / 依赖产物 / 模型权重 / 运行时数据 / 缓存 一律不入库
# ============================================================

# ---------- 虚拟环境 ----------
.venv/
.venv-train/
venv/
env/
shelwell_venv/
shelwell_train/
python=3.11/

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 依赖锁的临时文件 ----------
*.lock.tmp
pip-log.txt

# ---------- 模型权重 ----------
models/
Ollama_models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# ---------- 训练数据与产物 ----------
data/
!data/.gitkeep

# ---------- 运行时数据 ----------
memory/
logs/
*.log

# ---------- 数据库 ----------
*.db
*.sqlite
*.sqlite3

# ---------- 第三方工具（外置到 E:\Tools） ----------
tools/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地配置覆盖 ----------
config/local_*.yaml
.env
.env.local

# ---------- 临时文件 ----------
*.tmp
*.bak
*~
# ---------- QQ 接入运行时数据 ----------
adapters/qq_bot/qq_data/
adapters/qq_bot/napcat_data/
adapters/qq_bot/*.log
adapters/qq_bot/*.err